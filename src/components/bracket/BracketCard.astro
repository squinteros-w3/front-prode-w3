---
import { isDefined, slotName, winner } from '../../lib/bracket';
import type { BracketMatch, BracketSlot } from '../../lib/types';

interface Props {
  match: BracketMatch;
  x: number;
  y: number;
  width: number;
  height: number;
}
const { match, x, y, width, height } = Astro.props;

const win = winner(match);
const finished = match.status === 'FINISHED';
const defined = isDefined(match);
const accent = finished ? 'bg-w3-primary' : 'bg-w3-border-strong';

function row(side: 'home' | 'away') {
  const slot: BracketSlot = match[side];
  return {
    name: slotName(slot),
    flagUrl: slot.team?.flagUrl ?? null,
    isTeam: slot.team !== null,
    isWinner: win === side,
    score: finished && slot.score !== null ? slot.score : null,
    scoreFilled: win === side,
    dim: finished && win !== null && win !== side,
  };
}
const rows = [row('home'), row('away')];
---

<div
  class:list={[
    'absolute flex overflow-hidden rounded-[10px] border border-w3-border bg-w3-surface',
    !defined && 'opacity-70',
  ]}
  style={`left:${x}px;top:${y}px;width:${width}px;height:${height}px`}
>
  <div class:list={['w-1 shrink-0', accent]}></div>
  <div class="flex flex-1 flex-col justify-center gap-[3px] px-2.5">
    {
      rows.map((s) => (
        <div class="flex items-center justify-between gap-2">
          <div class="flex min-w-0 items-center gap-1.5">
            {s.isTeam ? (
              s.flagUrl ? (
                <img
                  src={s.flagUrl}
                  alt=""
                  class="h-[13px] w-[18px] shrink-0 rounded-[3px] object-cover ring-1 ring-white/10"
                />
              ) : (
                <span class="h-[13px] w-[18px] shrink-0 rounded-[3px] bg-white/10" />
              )
            ) : (
              <span class="h-[13px] w-[13px] shrink-0 rounded-full border border-w3-border-strong" />
            )}
            <span
              class:list={[
                'min-w-0 flex-1 truncate text-[13px]',
                s.isWinner
                  ? 'font-bold text-w3-white'
                  : s.dim || !s.isTeam
                    ? 'font-medium text-w3-text-muted'
                    : 'font-medium text-white/90',
              ]}
            >
              {s.name}
            </span>
          </div>
          <span
            class:list={[
              'grid h-[22px] w-[22px] shrink-0 place-items-center rounded-md font-display text-[13px] font-bold tabular-nums',
              s.scoreFilled
                ? 'bg-w3-surface-muted text-w3-white'
                : 'text-w3-text-muted',
            ]}
          >
            {s.score ?? '–'}
          </span>
        </div>
      ))
    }
  </div>
</div>
