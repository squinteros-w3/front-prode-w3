---
import {
  ROUND_STAGES,
  STAGE_SHORT,
  groupByStage,
  isDefined,
  pointsBadge,
  predictedAdvancer,
  predictionScore,
  slotName,
  wentToPens,
  winner,
} from '../../lib/bracket';
import { formatKickoffCompact } from '../../lib/format';
import type { BracketMatch } from '../../lib/types';

interface Props {
  bracket: BracketMatch[];
}
const { bracket } = Astro.props;

const groups = groupByStage(bracket);
const byStage = new Map(groups.map((g) => [g.stage, g]));

// Geometría del cuadro (replicada del diseño Pencil). Todas las rondas usan la
// misma card "rica" de 108px (fecha·sede, marcador y pronóstico), para que el
// look&feel sea idéntico en todas las fases. El centro de cada cruce cae justo
// en el medio del par que lo alimenta.
const CARD_W = 190;
const COL_PITCH = 244;
const RICH_H = 144; // alto de card: cabe meta + marcador + pronóstico con badge de puntos sin recortar
const V_GAP = 16; // separación vertical entre cards de la 1ª columna
const RICH_PITCH = RICH_H + V_GAP;
const TOP_MARGIN = 6;
const CENTER_BASE = TOP_MARGIN + RICH_H / 2; // centro de la 1ª card

const colX = (r: number) => r * COL_PITCH;
const cardH = (_r: number) => RICH_H;
// center(0,i)=CENTER_BASE+RICH_PITCH·i ; cada ronda se centra en el medio de su par.
const centerY = (r: number, i: number) =>
  CENTER_BASE + (RICH_PITCH / 2) * (2 ** r - 1) + RICH_PITCH * 2 ** r * i;
const topY = (r: number, i: number) => centerY(r, i) - cardH(r) / 2;

const rounds = ROUND_STAGES.map((stage, r) => ({
  stage,
  r,
  matches: byStage.get(stage)?.matches ?? [],
})).filter((x) => x.matches.length > 0);

const finalRound = rounds.find((x) => x.stage === 'final');
const third = byStage.get('third')?.matches[0] ?? null;
const finalX = finalRound ? colX(finalRound.r) : 0;
const finalCard = finalRound?.matches[0] ?? null;
const finalTop = finalRound ? topY(finalRound.r, 0) : 0;
const thirdTop = finalTop + RICH_H + 48;

interface Line {
  x: number;
  y: number;
  w: number;
  h: number;
}
const connectors: Line[] = [];
for (let k = 0; k < rounds.length - 1; k++) {
  const { r, matches } = rounds[k];
  const next = rounds[k + 1];
  const rightEdge = colX(r) + CARD_W;
  const midX = rightEdge + (COL_PITCH - CARD_W) / 2;
  const nextLeft = colX(next.r);
  const pairs = Math.floor(matches.length / 2);
  for (let p = 0; p < pairs; p++) {
    if (!next.matches[p]) continue;
    const yTop = centerY(r, 2 * p);
    const yBot = centerY(r, 2 * p + 1);
    const yMid = (yTop + yBot) / 2;
    connectors.push({ x: rightEdge, y: yTop, w: midX - rightEdge, h: 1 });
    connectors.push({ x: rightEdge, y: yBot, w: midX - rightEdge, h: 1 });
    connectors.push({ x: midX, y: yTop, w: 1, h: yBot - yTop });
    connectors.push({ x: midX, y: yMid, w: nextLeft - midX, h: 1 });
  }
}

let maxBottom = thirdTop + RICH_H;
for (const { r, matches } of rounds) {
  maxBottom = Math.max(maxBottom, topY(r, matches.length - 1) + cardH(r));
}
const canvasW = finalRound ? finalX + CARD_W : 0;

function td(m: BracketMatch, side: 'home' | 'away') {
  const slot = m[side];
  const win = winner(m);
  return {
    name: slotName(slot),
    flagUrl: slot.team?.flagUrl ?? null,
    isTeam: slot.team !== null,
    isWinner: win === side,
    score:
      m.status === 'FINISHED' && slot.score !== null ? String(slot.score) : '–',
    // Penales entre paréntesis pegados al gol, si el cruce fue a definición.
    penalty: wentToPens(m) && slot.penalties !== null ? String(slot.penalties) : null,
  };
}

function richMeta(m: BracketMatch): string {
  const parts: string[] = [];
  if (m.kickoffAt) parts.push(formatKickoffCompact(m.kickoffAt));
  if (m.city) parts.push(m.city);
  let base = parts.join(' · ').toUpperCase();
  if (!base) base = m.status === 'FINISHED' ? 'FINALIZADO' : 'A DEFINIR';
  return base;
}

const PTS_TONE: Record<string, string> = {
  primary: 'text-w3-primary',
  gold: 'text-w3-gold',
  muted: 'text-w3-text-muted',
};

const roundCards = rounds.map(({ r, matches }) => ({
  cards: matches.map((m, i) => ({
    m,
    x: colX(r),
    y: topY(r, i),
    home: td(m, 'home'),
    away: td(m, 'away'),
  })),
}));
const thirdData = third
  ? {
      m: third,
      home: td(third, 'home'),
      away: td(third, 'away'),
      defined: isDefined(third),
      meta: richMeta(third),
      badge: pointsBadge(third),
      predScore: predictionScore(third),
      advancer: predictedAdvancer(third),
    }
  : null;
const ThirdTag = thirdData?.defined ? 'a' : 'div';
const thirdHref = thirdData?.defined
  ? `/partidos?partido=${thirdData.m.externalId}`
  : undefined;
---

<div class="overflow-x-auto pb-2">
  <!-- Labels de ronda -->
  <div class="flex" style={`width:${canvasW}px`}>
    {
      rounds.map(({ stage, matches }, idx) => (
        <div
          class="flex flex-col items-center gap-[3px]"
          style={`width:${CARD_W}px${idx < rounds.length - 1 ? `;margin-right:${COL_PITCH - CARD_W}px` : ''}`}
        >
          <span class="font-display text-[13px] font-bold uppercase tracking-wide text-w3-primary">
            {STAGE_SHORT[stage]}
          </span>
          <span class="text-[11px] font-medium text-w3-text-muted">
            {matches.length} {matches.length === 1 ? 'cruce' : 'cruces'}
          </span>
        </div>
      ))
    }
  </div>

  <!-- Lienzo del cuadro -->
  <div class="relative mt-4" style={`width:${canvasW}px;height:${maxBottom}px`}>
    {
      connectors.map((l) => (
        <div
          class="absolute bg-w3-border-strong"
          style={`left:${l.x}px;top:${l.y}px;width:${l.w}px;height:${l.h}px`}
        />
      ))
    }

    {
      roundCards.map(({ cards }) =>
        cards.map(({ m, x, y, home, away }) => {
          const defined = isDefined(m);
          const Tag = defined ? 'a' : 'div';
          const href = defined
            ? `/partidos?partido=${m.externalId}`
            : undefined;
          const badge = pointsBadge(m);
          const predScore = predictionScore(m);
          const advancer = predictedAdvancer(m);
          // Malvinas: leyenda sobre la semifinal Argentina–Inglaterra (#102).
          const isMalvinas = m.externalId === '102';
          return (
            <Fragment>
              {isMalvinas && (
                <div
                  class="absolute z-10 flex items-center justify-center rounded-md border border-sky-400/40 bg-sky-500/15 px-2 py-1 text-center font-display text-[10px] font-bold uppercase leading-tight tracking-wide text-sky-100"
                  style={`left:${x - 15}px;top:${y - 46}px;width:${CARD_W + 30}px`}
                >
                  Las Malvinas fueron, son y serán siempre Argentinas
                </div>
              )}
              <Tag
                href={href}
                title={defined ? 'Cargá tu predicción' : undefined}
              class:list={[
                'absolute flex flex-col justify-between gap-1.5 overflow-hidden rounded-[10px] border border-w3-border bg-w3-surface px-3 py-2.5',
                defined && 'transition-colors hover:border-w3-primary-border',
              ]}
              style={`left:${x}px;top:${y}px;width:${CARD_W}px;height:${RICH_H}px`}
            >
              <span class="truncate text-[10px] font-bold tracking-[0.3px] text-w3-text-muted">
                {richMeta(m)}
              </span>

              <div class="flex flex-col gap-1.5">
                {[home, away].map((t) => (
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex min-w-0 items-center gap-[7px]">
                      {t.flagUrl ? (
                        <img
                          src={t.flagUrl}
                          alt=""
                          class="h-[12px] w-[18px] shrink-0 rounded-[3px] object-cover ring-1 ring-white/10"
                        />
                      ) : (
                        <span class="h-[12px] w-[18px] shrink-0 rounded-[3px] bg-white/10" />
                      )}
                      <span
                        class:list={[
                          'min-w-0 truncate text-[13px]',
                          t.isWinner
                            ? 'font-bold text-w3-white'
                            : t.isTeam
                              ? 'font-medium text-white/85'
                              : 'font-medium text-w3-text-muted',
                        ]}
                      >
                        {t.name}
                      </span>
                    </div>
                    <div class="flex shrink-0 items-center gap-1">
                      <span
                        class:list={[
                          'grid h-[22px] w-[22px] shrink-0 place-items-center rounded-md font-display text-[13px] font-bold tabular-nums',
                          t.isWinner
                            ? 'bg-w3-surface-muted text-w3-white'
                            : 'text-w3-text-muted',
                        ]}
                      >
                        {t.score}
                      </span>
                      {t.penalty !== null && (
                        <span
                          class:list={[
                            'font-display text-[11px] font-bold tabular-nums',
                            t.isWinner ? 'text-w3-white' : 'text-w3-text-muted',
                          ]}
                        >
                          ({t.penalty})
                        </span>
                      )}
                    </div>
                  </div>
                ))}
              </div>

              <div class="mt-0.5 flex items-center justify-between gap-2 border-t border-w3-border pt-2">
                <div class="flex min-w-0 items-center gap-1.5">
                  <span class="min-w-0 truncate text-[9.5px] font-semibold tracking-[0.2px] text-w3-text-muted">
                    Tu pronóstico
                  </span>
                  <span class="shrink-0 font-display text-[11.5px] font-bold tabular-nums text-w3-text-secondary">
                    {predScore ?? '—'}
                    {advancer && (
                      <span class="ml-1 inline-flex items-center gap-0.5 align-middle">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="10"
                          height="10"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="shrink-0 text-w3-text-muted"
                        >
                          <path d="m9 18 6-6-6-6" />
                        </svg>
                        {advancer.flagUrl ? (
                          <img
                            src={advancer.flagUrl}
                            alt={advancer.name}
                            class="h-[11px] w-[16px] shrink-0 rounded-[2px] object-cover ring-1 ring-white/10"
                          />
                        ) : (
                          <span class="font-sans text-[10px] font-semibold text-w3-text-muted">
                            {advancer.name}
                          </span>
                        )}
                      </span>
                    )}
                  </span>
                </div>
                {badge && (
                  <span class="shrink-0 rounded-md bg-w3-surface-muted px-[7px] py-[2px]">
                    <span
                      class:list={[
                        'font-display text-[11px] font-extrabold',
                        PTS_TONE[badge.tone],
                      ]}
                    >
                      {badge.short}
                    </span>
                  </span>
                )}
              </div>
              </Tag>
            </Fragment>
          );
        }),
      )
    }

    {
      finalCard && (
        <span
          class="absolute font-display text-[11px] font-bold uppercase tracking-wide text-w3-gold"
          style={`left:${finalX + 4}px;top:${finalTop - 20}px`}
        >
          Final
        </span>
      )
    }

    {
      thirdData && (
        <Fragment>
          <span
            class="absolute font-display text-[11px] font-bold uppercase tracking-wide text-w3-bronze"
            style={`left:${finalX + 4}px;top:${thirdTop - 20}px`}
          >
            3er y 4to puesto
          </span>
          <ThirdTag
            href={thirdHref}
            title={thirdData.defined ? 'Cargá tu predicción' : undefined}
            class:list={[
              'absolute flex flex-col justify-between gap-1.5 overflow-hidden rounded-[10px] border border-w3-border bg-w3-surface px-3 py-2.5',
              thirdData.defined &&
                'transition-colors hover:border-w3-primary-border',
            ]}
            style={`left:${finalX}px;top:${thirdTop}px;width:${CARD_W}px;height:${RICH_H}px`}
          >
            <span class="truncate text-[10px] font-bold tracking-[0.3px] text-w3-text-muted">
              {thirdData.meta}
            </span>

            <div class="flex flex-col gap-1.5">
              {[thirdData.home, thirdData.away].map((t) => (
                <div class="flex items-center justify-between gap-2">
                  <div class="flex min-w-0 items-center gap-[7px]">
                    {t.flagUrl ? (
                      <img
                        src={t.flagUrl}
                        alt=""
                        class="h-[12px] w-[18px] shrink-0 rounded-[3px] object-cover ring-1 ring-white/10"
                      />
                    ) : (
                      <span class="h-[12px] w-[18px] shrink-0 rounded-[3px] bg-white/10" />
                    )}
                    <span
                      class:list={[
                        'min-w-0 truncate text-[13px]',
                        t.isWinner
                          ? 'font-bold text-w3-white'
                          : t.isTeam
                            ? 'font-medium text-white/85'
                            : 'font-medium text-w3-text-muted',
                      ]}
                    >
                      {t.name}
                    </span>
                  </div>
                  <div class="flex shrink-0 items-center gap-1">
                    <span
                      class:list={[
                        'grid h-[22px] w-[22px] shrink-0 place-items-center rounded-md font-display text-[13px] font-bold tabular-nums',
                        t.isWinner
                          ? 'bg-w3-surface-muted text-w3-white'
                          : 'text-w3-text-muted',
                      ]}
                    >
                      {t.score}
                    </span>
                    {t.penalty !== null && (
                      <span
                        class:list={[
                          'font-display text-[11px] font-bold tabular-nums',
                          t.isWinner ? 'text-w3-white' : 'text-w3-text-muted',
                        ]}
                      >
                        ({t.penalty})
                      </span>
                    )}
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-0.5 flex items-center justify-between gap-2 border-t border-w3-border pt-2">
              <div class="flex min-w-0 items-center gap-1.5">
                <span class="min-w-0 truncate text-[9.5px] font-semibold tracking-[0.2px] text-w3-text-muted">
                  Tu pronóstico
                </span>
                <span class="shrink-0 font-display text-[11.5px] font-bold tabular-nums text-w3-text-secondary">
                  {thirdData.predScore ?? '—'}
                  {thirdData.advancer && (
                    <span class="ml-1 inline-flex items-center gap-0.5 align-middle">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="10"
                        height="10"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="shrink-0 text-w3-text-muted"
                      >
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                      {thirdData.advancer.flagUrl ? (
                        <img
                          src={thirdData.advancer.flagUrl}
                          alt={thirdData.advancer.name}
                          class="h-[11px] w-[16px] shrink-0 rounded-[2px] object-cover ring-1 ring-white/10"
                        />
                      ) : (
                        <span class="font-sans text-[10px] font-semibold text-w3-text-muted">
                          {thirdData.advancer.name}
                        </span>
                      )}
                    </span>
                  )}
                </span>
              </div>
              {thirdData.badge && (
                <span class="shrink-0 rounded-md bg-w3-surface-muted px-[7px] py-[2px]">
                  <span
                    class:list={[
                      'font-display text-[11px] font-extrabold',
                      PTS_TONE[thirdData.badge.tone],
                    ]}
                  >
                    {thirdData.badge.short}
                  </span>
                </span>
              )}
            </div>
          </ThirdTag>
        </Fragment>
      )
    }
  </div>
</div>
