---
interface Props {
  a: number;
  b: number;
}
const { a, b } = Astro.props;
---

<div
  class="flex items-center justify-center gap-2 text-xl font-extrabold tabular-nums"
>
  <span class="grid h-8 w-8 place-items-center rounded-md bg-white/5">{a}</span>
  <span class="text-white/30">-</span>
  <span class="grid h-8 w-8 place-items-center rounded-md bg-white/5">{b}</span>
</div>
