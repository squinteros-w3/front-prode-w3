---
import type { AppUser } from '../lib/types';

interface Props {
  user: AppUser;
  active?:
    | 'partidos'
    | 'grupos'
    | 'eliminatoria'
    | 'leaderboard'
    | 'puntos'
    | 'perfil'
    | 'admin';
}

const { user, active } = Astro.props;

const links: { href: string; label: string; key: Props['active'] }[] = [
  { href: '/partidos', label: 'Partidos', key: 'partidos' },
  { href: '/grupos', label: 'Grupos', key: 'grupos' },
  { href: '/eliminatoria', label: 'Eliminatoria', key: 'eliminatoria' },
  { href: '/leaderboard', label: 'Tabla', key: 'leaderboard' },
  { href: '/puntajes', label: 'Reglas', key: 'puntos' },
  { href: '/perfil', label: 'Perfil', key: 'perfil' },
];
if (user.role === 'ADMIN') {
  links.push({ href: '/admin', label: 'Admin', key: 'admin' });
}

const initials = user.name
  .split(' ')
  .map((p) => p[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-w3-black/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 w-full max-w-5xl items-center gap-4 px-4 sm:px-6">
    <a
      href="/partidos"
      class="flex items-center gap-2.5 font-extrabold tracking-tight"
    >
      <svg
        class="h-7 w-auto text-w3-primary"
        viewBox="0 0 270 192"
        fill="none"
        role="img"
        aria-label="W3"
      >
        <path
          fill="currentColor"
          d="M130.709 157H122.709L90.8687 45H98.8688L130.709 157ZM3.66875 45H11.6688L50.3888 157H42.3888L3.66875 45ZM50.3888 157L82.8688 45H90.8687L58.3888 157H50.3888ZM130.709 157L171.829 45H179.829L138.709 157H130.709ZM226.073 159.24C208.153 159.24 193.113 149.8 189.913 130.28H197.913C201.113 145 212.633 152.2 226.073 152.2C239.833 152.2 252.313 143.4 252.313 127.08C252.313 111.08 240.153 101.96 226.073 101.96H220.953V94.92H226.073C240.153 94.92 249.113 85.16 249.113 72.36C249.113 59.24 239.833 49.8 226.073 49.8C213.593 49.8 203.993 56.36 200.793 68.52H192.793C195.993 51.56 210.073 42.76 226.073 42.76C244.953 42.76 256.793 56.04 256.793 72.36C256.793 83.88 250.553 93.8 239.993 98.28C251.833 102.76 259.993 113 259.993 127.08C259.993 146.6 244.953 159.24 226.073 159.24Z"
        ></path>
      </svg>
      <span>Prode <span class="text-w3-primary">2026</span></span>
    </a>

    {/* Links desktop */}
    <div class="ml-auto hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              active === l.key
                ? 'bg-w3-primary/15 text-w3-primary'
                : 'text-white/70 hover:bg-white/5 hover:text-white',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-3 lg:ml-3">
      {
        user.avatarUrl ? (
          <img
            src={user.avatarUrl}
            alt={user.name}
            class="h-9 w-9 rounded-full border border-white/15 object-cover"
          />
        ) : (
          <span class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-xs font-semibold">
            {initials}
          </span>
        )
      }
      <a
        href="/api/auth/logout"
        title="Cerrar sesión"
        class="hidden text-sm text-white/50 transition-colors hover:text-white lg:inline"
        >Salir</a
      >

      {/* Botón hamburguesa (mobile) */}
      <button
        id="navToggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="grid h-9 w-9 place-items-center rounded-lg border border-white/15 text-white/80 transition-colors hover:bg-white/5 lg:hidden"
      >
        <svg
          id="navIconOpen"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="navIconClose"
          class="hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  {/* Menú mobile desplegable */}
  <div
    id="mobileMenu"
    class="hidden border-t border-white/10 bg-w3-black/95 px-4 pb-4 pt-2 backdrop-blur-md lg:hidden"
  >
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
              active === l.key
                ? 'bg-w3-primary/15 text-w3-primary'
                : 'text-white/80 hover:bg-white/5',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/api/auth/logout"
        class="mt-1 rounded-lg px-3 py-2.5 text-sm font-medium text-white/50 hover:bg-white/5"
        >Cerrar sesión</a
      >
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');
  const iconOpen = document.getElementById('navIconOpen');
  const iconClose = document.getElementById('navIconClose');

  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
