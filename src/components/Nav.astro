---
import type { AppUser } from '../lib/types';

interface Props {
  user: AppUser;
  active?:
    | 'partidos'
    | 'grupos'
    | 'eliminatoria'
    | 'leaderboard'
    | 'puntos'
    | 'perfil'
    | 'admin';
}

const { user, active } = Astro.props;

const links: { href: string; label: string; key: Props['active'] }[] = [
  { href: '/partidos', label: 'Partidos', key: 'partidos' },
  { href: '/grupos', label: 'Grupos', key: 'grupos' },
  { href: '/eliminatoria', label: 'Eliminatoria', key: 'eliminatoria' },
  { href: '/leaderboard', label: 'Tabla', key: 'leaderboard' },
  { href: '/puntajes', label: 'Puntos', key: 'puntos' },
  { href: '/perfil', label: 'Perfil', key: 'perfil' },
];
if (user.role === 'ADMIN') {
  links.push({ href: '/admin', label: 'Admin', key: 'admin' });
}

const initials = user.name
  .split(' ')
  .map((p) => p[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-w3-black/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 w-full max-w-5xl items-center gap-4 px-4 sm:px-6">
    <a
      href="/partidos"
      class="flex items-center gap-2 font-extrabold tracking-tight"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-lg bg-w3-primary text-w3-black"
        >W3</span
      >
      <span>Prode <span class="text-w3-primary">2026</span></span>
    </a>

    {/* Links desktop */}
    <div class="ml-auto hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              active === l.key
                ? 'bg-w3-primary/15 text-w3-primary'
                : 'text-white/70 hover:bg-white/5 hover:text-white',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-3 lg:ml-3">
      {
        user.avatarUrl ? (
          <img
            src={user.avatarUrl}
            alt={user.name}
            class="h-9 w-9 rounded-full border border-white/15 object-cover"
          />
        ) : (
          <span class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-xs font-semibold">
            {initials}
          </span>
        )
      }
      <a
        href="/api/auth/logout"
        title="Cerrar sesión"
        class="hidden text-sm text-white/50 transition-colors hover:text-white lg:inline"
        >Salir</a
      >

      {/* Botón hamburguesa (mobile) */}
      <button
        id="navToggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="grid h-9 w-9 place-items-center rounded-lg border border-white/15 text-white/80 transition-colors hover:bg-white/5 lg:hidden"
      >
        <svg
          id="navIconOpen"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="navIconClose"
          class="hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  {/* Menú mobile desplegable */}
  <div
    id="mobileMenu"
    class="hidden border-t border-white/10 bg-w3-black/95 px-4 pb-4 pt-2 backdrop-blur-md lg:hidden"
  >
    <div class="mx-auto flex w-full max-w-5xl flex-col gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm font-medium transition-colors',
              active === l.key
                ? 'bg-w3-primary/15 text-w3-primary'
                : 'text-white/80 hover:bg-white/5',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/api/auth/logout"
        class="mt-1 rounded-lg px-3 py-2.5 text-sm font-medium text-white/50 hover:bg-white/5"
        >Cerrar sesión</a
      >
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('navToggle');
  const menu = document.getElementById('mobileMenu');
  const iconOpen = document.getElementById('navIconOpen');
  const iconClose = document.getElementById('navIconClose');

  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
