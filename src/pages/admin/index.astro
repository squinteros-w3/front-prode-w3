---
import AdminPanel from '../../components/AdminPanel.tsx';
import Layout from '../../layouts/Layout.astro';
import { getAdminMatches, getAdminUsers } from '../../lib/api';

export const prerender = false;

const token = Astro.locals.token;
const [matches, users] = await Promise.all([
  getAdminMatches(token),
  getAdminUsers(token),
]);
---

<Layout title="Admin — Prode W3" active="admin">
  <h1 class="font-display mb-1 text-2xl font-extrabold tracking-tight sm:text-[34px]">
    Panel de administración
  </h1>
  <p class="mb-6 text-sm text-w3-text-secondary sm:text-[15px]">
    Sincronización, carga manual de resultados y gestión de usuarios.
  </p>

  <AdminPanel client:load matches={matches} users={users} />
</Layout>
