---
import MatchesView from '../components/matches/MatchesView.tsx';
import Layout from '../layouts/Layout.astro';
import { getMatches } from '../lib/api';

export const prerender = false;

const matches = await getMatches(Astro.locals.token);
const focusMatchId = Astro.url.searchParams.get('partido');
---

<Layout title="Partidos — Prode W3" active="partidos">
  <MatchesView client:load matches={matches} focusMatchId={focusMatchId} />
</Layout>
