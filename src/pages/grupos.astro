---
import GroupsView from '../components/groups/GroupsView.tsx';
import Layout from '../layouts/Layout.astro';
import { getGroups, getMatches, getThirdPlace } from '../lib/api';

export const prerender = false;

const [groups, matches, thirdPlace] = await Promise.all([
  getGroups(Astro.locals.token),
  getMatches(Astro.locals.token),
  getThirdPlace(Astro.locals.token),
]);

const grupoParam = Astro.url.searchParams.get('grupo');
const validGroups = new Set(groups.map((g) => g.group));
const initialGroup =
  grupoParam && validGroups.has(grupoParam) ? grupoParam : null;
---

<Layout title="Grupos — Prode W3" active="grupos">
  <GroupsView
    client:load
    groups={groups}
    matches={matches}
    thirdPlace={thirdPlace}
    initialGroup={initialGroup}
  />
</Layout>
