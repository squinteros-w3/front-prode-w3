---
import AvatarEditor from '../components/AvatarEditor.tsx';
import Layout from '../layouts/Layout.astro';
import { getStats } from '../lib/api';

export const prerender = false;

const user = Astro.locals.user!;
const stats = await getStats(Astro.locals.token);

const cards = stats
  ? [
      { label: 'Puntos', value: stats.totalPoints, accent: true },
      {
        label: 'Posición',
        value: stats.rank ? `${stats.rank}º` : '—',
        sub: stats.totalPlayers ? `de ${stats.totalPlayers}` : undefined,
      },
      { label: 'Exactos', value: stats.exactCount },
      { label: 'Mejor racha', value: stats.bestStreak },
    ]
  : [];
---

<Layout title="Perfil — Prode W3" active="perfil">
  <div class="mb-8 flex flex-col items-center text-center">
    <AvatarEditor client:load name={user.name} avatarUrl={user.avatarUrl} />
    <h1 class="font-display mt-4 text-xl font-extrabold sm:text-2xl">{user.name}</h1>
    <p class="text-sm text-w3-text-muted">{user.email}</p>
    {
      user.role === 'ADMIN' && (
        <span class="mt-2 rounded-full border border-w3-primary-border bg-w3-primary-soft px-3 py-0.5 text-xs font-medium text-w3-primary">
          Administrador
        </span>
      )
    }
  </div>

  <div class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {
      cards.map((c) => (
        <div
          class:list={[
            'rounded-w3-card border p-4 text-center',
            c.accent
              ? 'border-w3-primary-border bg-w3-primary-soft'
              : 'border-w3-border bg-w3-surface',
          ]}
        >
          <div
            class:list={[
              'text-3xl font-extrabold',
              c.accent ? 'text-w3-primary' : 'text-w3-white',
            ]}
          >
            {c.value}
          </div>
          <div class="mt-1 text-xs uppercase tracking-wide text-w3-text-muted">
            {c.label}
          </div>
          {c.sub && <div class="text-[10px] text-w3-text-muted">{c.sub}</div>}
        </div>
      ))
    }
  </div>

  {
    stats && (
      <section>
        <div class="mb-3">
          <h2 class="font-display text-sm font-bold uppercase tracking-wide text-w3-text-secondary">
            Medallas
          </h2>
          <p class="mt-0.5 text-xs text-w3-text-muted">
            Son logros y no suman puntos — el puntaje sale solo de tus predicciones.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {stats.medals.map((m) => (
            <div
              class:list={[
                'flex items-center gap-3 rounded-w3-card border p-3 transition-opacity',
                m.earned
                  ? 'border-w3-primary-border bg-w3-primary-soft/50'
                  : 'border-w3-border bg-w3-surface opacity-40',
              ]}
            >
              <span
                class:list={[
                  'grid h-10 w-10 shrink-0 place-items-center rounded-lg text-lg',
                  m.earned ? 'bg-w3-primary text-w3-black' : 'bg-w3-score-box',
                ]}
              >
                {m.earned ? '★' : '☆'}
              </span>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold">{m.label}</p>
                <p class="truncate text-xs text-w3-text-muted">{m.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Layout>
