---
import Layout from '../layouts/Layout.astro';
import TeamRow from '../components/TeamRow.astro';
import { getBracket } from '../lib/api';
import { formatKickoff } from '../lib/format';
import type { BracketMatch, BracketSlot } from '../lib/types';

export const prerender = false;

const STAGE_ORDER = ['r32', 'r16', 'qf', 'sf', 'third', 'final'];
const STAGE_LABELS: Record<string, string> = {
  r32: '32avos de final',
  r16: 'Octavos de final',
  qf: 'Cuartos de final',
  sf: 'Semifinales',
  third: 'Tercer puesto',
  final: 'Final',
};

const bracket = await getBracket(Astro.locals.token);

const byStage = STAGE_ORDER.map((stage) => ({
  stage,
  label: STAGE_LABELS[stage] ?? stage,
  matches: bracket
    .filter((m) => m.stage === stage)
    .sort((a, b) => {
      // Sin fecha aún (cruce no programado): mantené el orden del cuadro.
      if (!a.kickoffAt || !b.kickoffAt) {
        return Number(a.externalId) - Number(b.externalId);
      }
      return new Date(a.kickoffAt).getTime() - new Date(b.kickoffAt).getTime();
    }),
})).filter((s) => s.matches.length > 0);

function winner(m: BracketMatch): 'home' | 'away' | null {
  if (m.status !== 'FINISHED' || m.home.score === null || m.away.score === null)
    return null;
  if (m.home.score > m.away.score) return 'home';
  if (m.away.score > m.home.score) return 'away';
  // Empate en los 90'/prórroga: se define por penales (los carga el admin).
  if (m.home.penalties !== null && m.away.penalties !== null) {
    if (m.home.penalties > m.away.penalties) return 'home';
    if (m.away.penalties > m.home.penalties) return 'away';
  }
  return null;
}

function wentToPens(m: BracketMatch): boolean {
  return m.home.penalties !== null && m.away.penalties !== null;
}

// Nombre a mostrar: el equipo si ya está definido, si no la etiqueta del cruce.
function slotName(slot: BracketSlot): string {
  return slot.team?.name ?? slot.label ?? 'A definir';
}
---

<Layout title="Eliminatoria — Prode W3" active="eliminatoria">
  <div class="mb-6">
    <h1 class="font-display text-2xl font-extrabold tracking-tight sm:text-[34px]">
      Fase eliminatoria
    </h1>
    <p class="mt-1.5 text-sm text-w3-text-secondary sm:text-[15px]">
      El cuadro completo desde 32avos. Los equipos se van completando a medida
      que se definen los grupos y avanzan las llaves.
    </p>
  </div>

  {
    byStage.length === 0 ? (
      <div class="rounded-w3-card border border-w3-border bg-w3-surface p-8 text-center">
        <p class="text-4xl">🏆</p>
        <p class="mt-3 font-semibold">El cuadro todavía no está disponible</p>
        <p class="mx-auto mt-1 max-w-sm text-sm text-w3-text-secondary">
          En cuanto se publique el fixture de la eliminatoria vas a ver acá
          todos los cruces.
        </p>
      </div>
    ) : (
      <div class="space-y-8">
        {byStage.map((s) => (
          <section>
            <h2 class="mb-3 flex items-center gap-2 text-[13px] font-bold uppercase tracking-wide text-w3-primary">
              {s.label}
              <span class="rounded-full bg-w3-score-box px-2 py-0.5 text-[11px] text-w3-text-muted">
                {s.matches.length}
              </span>
            </h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {s.matches.map((m) => {
                const win = winner(m);
                const finished = m.status === 'FINISHED';
                const defined = m.home.team !== null && m.away.team !== null;
                return (
                  <div class="rounded-2xl border border-w3-border bg-w3-surface p-4 sm:rounded-w3-card">
                    <div class="mb-2 flex items-center justify-between text-xs text-w3-text-muted">
                      <span>
                        {m.kickoffAt ? formatKickoff(m.kickoffAt) : 'Fecha por confirmar'}
                      </span>
                      <span
                        class:list={[
                          'rounded-full px-2 py-0.5 font-medium',
                          finished
                            ? 'bg-w3-score-box text-w3-text-secondary'
                            : defined
                              ? 'bg-w3-primary-soft text-w3-primary'
                              : 'bg-w3-score-box text-w3-text-muted',
                        ]}
                      >
                        {finished
                          ? 'Finalizado'
                          : defined
                            ? 'Por jugarse'
                            : 'A definir'}
                      </span>
                    </div>

                    <TeamRow
                      name={slotName(m.home)}
                      flagUrl={m.home.team?.flagUrl ?? null}
                      score={m.home.score}
                      finished={finished}
                      isWinner={win === 'home'}
                    />
                    <div class="my-1 h-px bg-w3-border" />
                    <TeamRow
                      name={slotName(m.away)}
                      flagUrl={m.away.team?.flagUrl ?? null}
                      score={m.away.score}
                      finished={finished}
                      isWinner={win === 'away'}
                    />

                    {wentToPens(m) && (
                      <div class="mt-2 flex items-center justify-center gap-1.5 rounded-lg bg-w3-surface-muted py-1.5 text-xs text-w3-text-secondary">
                        <span aria-hidden="true">⚽</span>
                        <span>
                          Definido por penales{' '}
                          <strong class="text-w3-white">
                            {m.home.penalties}–{m.away.penalties}
                          </strong>
                        </span>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    )
  }
</Layout>
