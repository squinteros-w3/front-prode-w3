---
import Layout from '../layouts/Layout.astro';
import BracketDesktop from '../components/bracket/BracketDesktop.astro';
import BracketStepper from '../components/bracket/BracketStepper.astro';
import { getBracket } from '../lib/api';
import { groupByStage } from '../lib/bracket';

export const prerender = false;

const bracket = await getBracket(Astro.locals.token);
const hasMatches = groupByStage(bracket).length > 0;
---

<Layout title="Eliminatoria — Prode W3" active="eliminatoria">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-2xl font-extrabold tracking-tight sm:text-[34px]">
        Fase eliminatoria
      </h1>
      <p class="mt-1.5 max-w-xl text-sm text-w3-text-secondary sm:text-[15px]">
        El cuadro se completa con los resultados reales a medida que se juegan.
      </p>
    </div>

    <!-- Leyenda neutral (estado real del cruce) -->
    <div class="hidden shrink-0 items-center gap-4 text-[13px] text-w3-text-secondary lg:flex">
      <span class="flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-w3-primary"></span>
        Jugado
      </span>
      <span class="flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-w3-border-strong"></span>
        Pendiente
      </span>
    </div>
  </div>

  {
    !hasMatches ? (
      <div class="rounded-w3-card border border-w3-border bg-w3-surface p-8 text-center">
        <p class="text-4xl">🏆</p>
        <p class="mt-3 font-semibold">El cuadro todavía no está disponible</p>
        <p class="mx-auto mt-1 max-w-sm text-sm text-w3-text-secondary">
          En cuanto se publique el fixture de la eliminatoria vas a ver acá
          todos los cruces.
        </p>
      </div>
    ) : (
      <Fragment>
        <div class="hidden lg:block">
          <BracketDesktop bracket={bracket} />
        </div>
        <div class="lg:hidden">
          <BracketStepper bracket={bracket} />
        </div>
      </Fragment>
    )
  }
</Layout>
