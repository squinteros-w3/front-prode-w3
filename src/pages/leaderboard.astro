---
import Layout from '../layouts/Layout.astro';
import { getLeaderboard } from '../lib/api';

export const prerender = false;

const board = await getLeaderboard(Astro.locals.token);
const me = Astro.locals.user;
const podium = board.slice(0, 3);

const order = [1, 0, 2]; // 2º, 1º, 3º para el podio visual
const heights = ['h-24', 'h-32', 'h-20'];
const medals = ['🥈', '🥇', '🥉'];

function initials(name: string) {
  return name
    .split(' ')
    .map((p) => p[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
}
---

<Layout title="Tabla — Prode W3" active="leaderboard">
  <h1 class="mb-1 text-2xl font-extrabold tracking-tight sm:text-3xl">
    Tabla de posiciones
  </h1>
  <p class="mb-6 text-sm text-white/50">
    Ordenada por puntos · desempate por resultados exactos
  </p>

  {
    podium.length >= 3 && (
      <div class="mb-8 grid grid-cols-3 items-end gap-2 sm:gap-4">
        {order.map((idx, i) => {
          const e = podium[idx];
          if (!e) return null;
          return (
            <div class="flex flex-col items-center">
              <div class="mb-2 text-2xl">{medals[i]}</div>
              {e.user.avatarUrl ? (
                <img
                  src={e.user.avatarUrl}
                  alt={e.user.name}
                  class="mb-2 h-12 w-12 rounded-full border-2 border-w3-primary/40 object-cover"
                />
              ) : (
                <span class="mb-2 grid h-12 w-12 place-items-center rounded-full bg-white/10 text-sm font-bold">
                  {initials(e.user.name)}
                </span>
              )}
              <p class="max-w-full truncate text-center text-xs font-medium">
                {e.user.name}
              </p>
              <div
                class:list={[
                  'mt-2 flex w-full flex-col items-center justify-end rounded-t-xl border-x border-t border-white/10',
                  heights[i],
                  idx === 0 ? 'bg-w3-primary/15' : 'bg-white/5',
                ]}
              >
                <span class="py-2 text-lg font-extrabold text-w3-primary">
                  {e.points}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    )
  }

  <div class="overflow-hidden rounded-xl border border-white/10">
    <table class="w-full text-sm">
      <thead class="bg-white/5 text-left text-xs uppercase tracking-wide text-white/40">
        <tr>
          <th class="px-3 py-2.5 sm:px-4">#</th>
          <th class="px-3 py-2.5 sm:px-4">Jugador</th>
          <th class="px-3 py-2.5 text-center">Exactos</th>
          <th class="px-3 py-2.5 pr-4 text-right">Puntos</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {
          board.map((e) => (
            <tr
              class:list={[
                'transition-colors',
                e.user.id === me?.id ? 'bg-w3-primary/10' : 'hover:bg-white/[0.03]',
              ]}
            >
              <td class="px-3 py-3 font-mono text-white/40 sm:px-4">{e.rank}</td>
              <td class="px-3 py-3 sm:px-4">
                <div class="flex items-center gap-2.5">
                  {e.user.avatarUrl ? (
                    <img
                      src={e.user.avatarUrl}
                      alt=""
                      class="h-7 w-7 rounded-full object-cover"
                    />
                  ) : (
                    <span class="grid h-7 w-7 place-items-center rounded-full bg-white/10 text-[10px] font-semibold">
                      {initials(e.user.name)}
                    </span>
                  )}
                  <span class="font-medium">
                    {e.user.name}
                    {e.user.id === me?.id && (
                      <span class="ml-1 text-xs text-w3-primary">(vos)</span>
                    )}
                  </span>
                </div>
              </td>
              <td class="px-3 py-3 text-center text-white/60">{e.exacts}</td>
              <td class="px-3 py-3 pr-4 text-right font-bold text-w3-primary">
                {e.points}
              </td>
            </tr>
          ))
        }
        {
          board.length === 0 && (
            <tr>
              <td colspan="4" class="px-4 py-8 text-center text-white/40">
                Todavía no hay puntajes.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</Layout>
