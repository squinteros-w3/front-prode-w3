---
import LeaderboardView from '../components/leaderboard/LeaderboardView.tsx';
import Layout from '../layouts/Layout.astro';
import { getLeaderboard } from '../lib/api';

export const prerender = false;

const board = await getLeaderboard(Astro.locals.token);
const me = Astro.locals.user;
---

<Layout title="Tabla — Prode W3" active="leaderboard">
  <LeaderboardView client:load board={board} meId={me?.id ?? null} />
</Layout>
