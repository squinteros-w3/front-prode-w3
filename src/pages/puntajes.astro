---
import Layout from '../layouts/Layout.astro';
import Scoreline from '../components/Scoreline.astro';

export const prerender = false;

type Tone = 'exact' | 'outcome' | 'miss';

const rules: {
  points: number;
  title: string;
  desc: string;
  pred: [number, number];
  real: [number, number];
  tone: Tone;
}[] = [
  {
    points: 3,
    title: 'Resultado exacto',
    desc: 'Le pegás al marcador justo de los dos equipos.',
    pred: [2, 1],
    real: [2, 1],
    tone: 'exact',
  },
  {
    points: 1,
    title: 'Acertás el ganador (o el empate)',
    desc: 'Acertás quién gana o que empatan, pero no el marcador exacto.',
    pred: [2, 0],
    real: [3, 1],
    tone: 'outcome',
  },
  {
    points: 0,
    title: 'No acertaste',
    desc: 'El resultado terminó distinto a tu predicción.',
    pred: [1, 2],
    real: [2, 1],
    tone: 'miss',
  },
];

const toneStyles: Record<
  Tone,
  { card: string; badge: string; ring: string }
> = {
  exact: {
    card: 'border-w3-primary-border bg-w3-primary-soft',
    badge: 'bg-w3-primary text-w3-black',
    ring: 'ring-w3-primary-border',
  },
  outcome: {
    card: 'border-w3-border bg-w3-surface',
    badge: 'bg-w3-primary-soft text-w3-primary',
    ring: 'ring-w3-border',
  },
  miss: {
    card: 'border-w3-border bg-w3-surface-muted',
    badge: 'bg-w3-score-box text-w3-text-muted',
    ring: 'ring-w3-border',
  },
};

// Puntaje de los cruces de eliminación (con elección de ganador por penales).
type KoTone = 'bonus' | 'exact' | 'outcome';
const koRules: { points: string; tone: KoTone; title: string; detail: string }[] =
  [
    {
      points: '+5',
      tone: 'bonus',
      title: 'Empate exacto + ganador de penales',
      detail:
        'Pronosticás 2–2 y que gana el Local. Sale 2–2 y el Local pasa por penales: +3 del exacto y +2 del ganador.',
    },
    {
      points: '+3',
      tone: 'exact',
      title: 'Empate exacto, ganador errado',
      detail:
        'Pronosticás 2–2 y que gana el Local, pero pasa el Visitante: +3 del empate exacto, 0 del ganador.',
    },
    {
      points: '+1',
      tone: 'outcome',
      title: 'Empate inexacto',
      detail:
        'Pronosticás 2–2 y sale 1–1: solo +1 por acertar el empate, sin el bonus del ganador.',
    },
    {
      points: '+3',
      tone: 'exact',
      title: 'Resultado con ganador',
      detail:
        'Si pronosticás un ganador (no empate) puntúa igual que siempre: +3 exacto, +1 solo el ganador.',
    },
  ];
const koBadge: Record<KoTone, string> = {
  bonus: 'bg-w3-gold-soft text-w3-gold',
  exact: 'bg-w3-primary text-w3-black',
  outcome: 'bg-w3-primary-soft text-w3-primary',
};
---

<Layout title="Puntos — Prode W3" active="puntos">
  <div class="mb-8 text-center sm:mb-10">
    <h1 class="font-display text-2xl font-extrabold tracking-tight sm:text-[34px]">
      ¿Cómo se suman los puntos?
    </h1>
    <p class="mx-auto mt-2 max-w-md text-sm text-w3-text-secondary sm:text-[15px]">
      Cargás tu marcador antes de cada partido. Cuando termina, sumás según
      cuánto le acertaste.
    </p>
  </div>

  <div class="space-y-4">
    {
      rules.map((r) => {
        const s = toneStyles[r.tone];
        return (
          <div
            class:list={[
              'flex flex-col items-center gap-5 rounded-w3-card border p-5 sm:flex-row sm:gap-6 sm:p-6',
              s.card,
            ]}
          >
            <div class="flex shrink-0 flex-col items-center">
              <span
                class:list={[
                  'grid h-20 w-20 place-items-center rounded-2xl text-3xl font-extrabold tabular-nums',
                  s.badge,
                ]}
              >
                +{r.points}
              </span>
              <span class="mt-1.5 text-[11px] uppercase tracking-wide text-w3-text-muted">
                {r.points === 1 ? 'punto' : 'puntos'}
              </span>
            </div>

            <div class="min-w-0 flex-1 text-center sm:text-left">
              <h2 class="font-display text-lg font-bold">{r.title}</h2>
              <p class="mt-0.5 text-sm text-w3-text-secondary">{r.desc}</p>
            </div>

            <div
              class:list={[
                'flex shrink-0 gap-3 rounded-xl bg-w3-surface-muted p-3 ring-1',
                s.ring,
              ]}
            >
              <div class="text-center">
                <p class="mb-1 text-[10px] uppercase tracking-wide text-w3-text-muted">
                  Tu predicción
                </p>
                <Scoreline a={r.pred[0]} b={r.pred[1]} />
              </div>
              <div class="w-px self-stretch bg-w3-border" />
              <div class="text-center">
                <p class="mb-1 text-[10px] uppercase tracking-wide text-w3-text-muted">
                  Resultado
                </p>
                <Scoreline a={r.real[0]} b={r.real[1]} />
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  <section
    id="cruces"
    class="mt-8 scroll-mt-24 rounded-w3-card border border-w3-border bg-w3-surface p-5 sm:scroll-mt-28 sm:p-6"
  >
    <div class="mb-2 flex items-center gap-2">
      <span
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-w3-gold-soft px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wide text-w3-gold"
      >
        Eliminatoria
      </span>
      <h2 class="font-display text-lg font-bold sm:text-xl">
        Cómo se puntúan los cruces
      </h2>
    </div>

    <p class="mb-4 max-w-2xl text-sm text-w3-text-secondary">
      En la eliminación los partidos no pueden terminar empatados: si
      pronosticás un empate, también elegís quién pasa por penales. Ese
      pronóstico suma un extra solo si acertás el
      <strong class="text-w3-white"> empate exacto</strong> y además el
      <strong class="text-w3-white"> ganador</strong>.
    </p>

    <div class="grid gap-2.5 sm:grid-cols-2">
      {
        koRules.map((r) => (
          <div class="flex items-start gap-3 rounded-xl border border-w3-border bg-w3-surface-muted px-3.5 py-3">
            <span
              class:list={[
                'mt-0.5 inline-flex shrink-0 items-center justify-center rounded-full px-2.5 py-0.5 text-xs font-bold tabular-nums',
                koBadge[r.tone],
              ]}
            >
              {r.points}
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-w3-white">{r.title}</p>
              <p class="mt-0.5 text-[13px] leading-snug text-w3-text-muted">
                {r.detail}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="mt-8 grid gap-3 sm:grid-cols-2">
    <div class="rounded-w3-card border border-w3-border bg-w3-surface p-4">
      <p class="font-display text-sm font-bold text-w3-primary">Desempate</p>
      <p class="mt-1 text-sm text-w3-text-secondary">
        Si dos personas tienen los mismos puntos, queda arriba quien tenga más
        <strong class="text-w3-white"> resultados exactos</strong>.
      </p>
    </div>
    <div class="rounded-w3-card border border-w3-border bg-w3-surface p-4">
      <p class="font-display text-sm font-bold text-w3-primary">Cierre de predicción</p>
      <p class="mt-1 text-sm text-w3-text-secondary">
        Cada partido se cierra
        <strong class="text-w3-white"> 15 minutos antes</strong> del inicio
        (horario argentino). Después no se puede editar.
      </p>
    </div>
  </div>
</Layout>
